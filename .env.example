# ============================================================================
# Mii Plaza — environment
# ============================================================================
# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deploys.
#
# Everything here is optional. Each integration degrades on its own:
#   no Supabase   -> plaza runs on the legacy file/Upstash store, no Realtime
#   no JWT_SECRET -> no session cookies, so no editing across reloads
#   no Resend     -> badges still issue, just not emailed
#   no Wallet     -> badge shows a QR instead of Add to Apple / Google Wallet
#   no admin key  -> /admin stays locked
# ============================================================================

# ---------------------------------------------------------------- Supabase --
# Project settings → API. The NEXT_PUBLIC_ spellings are also accepted.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Run supabase/schema.sql once against this project before first use.

# -------------------------------------------------------------------- Email --
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
RESEND_FROM=CO—WORKING <badges@coworking.fyi>

# ------------------------------------------------------------ Google Wallet --
# Google Pay & Wallet Console → issuer account.
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full PEM. Literal \n sequences are unescaped at load, so the
# single-line form Vercel's UI produces works as-is.
GOOGLE_PRIVATE_KEY=

# ------------------------------------------------------------- Apple Wallet --
# Certificates → Pass Type IDs in the Apple Developer portal. Convert the
# downloaded .p12:
#   openssl pkcs12 -in pass.p12 -clcerts -nokeys -out cert.pem
#   openssl pkcs12 -in pass.p12 -nocerts -nodes -out key.pem
# Paste the PEM bodies. The WWDR intermediate is vendored; override only if
# Apple rotates it.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
# Only if the key PEM is encrypted.
APPLE_PASS_KEY_PASSPHRASE=

# --------------------------------------------------------- Admin and auth ---
# Unlocks /admin. Long and random.
ADMIN_SECRET_KEY=
# Signs session cookies, badge QR tokens, and salts rate-limit buckets.
# Minimum 16 chars; rotating it signs everyone out and invalidates old QRs.
JWT_SECRET=

# ------------------------------------------------------------------ Origin --
# Absolute URLs in emails and Wallet passes. Inferred from the request and
# Vercel's own env vars when unset; set it to pin the canonical domain.
PUBLIC_ORIGIN=https://coworking.fyi

# ------------------------------------------------- Limits (all optional) ----
# Badge creations per IP per window (the brief's 3/hour).
MII_CREATE_LIMIT=3
MII_CREATE_WINDOW=3600
# Edits and deletes per IP per window.
MII_WRITE_LIMIT=30
MII_WRITE_WINDOW=3600
# Magic-link requests per IP per window.
MII_MAGIC_LIMIT=5
MII_MAGIC_WINDOW=3600

# ------------------------------------- Legacy store (pre-Supabase fallback) --
# Only used when SUPABASE_* is absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
